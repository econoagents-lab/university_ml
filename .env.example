# Machine Learning University v0.2 · Sperant/Redshift
# Copia este archivo como .env y completa tus credenciales localmente.
# Nunca subas .env a GitHub.

# Modo de datos:
# synthetic = dataset educativo seguro.
# sperant = usa data/processed/gold/riesgo_caida_training.parquet.
MLU_DATA_MODE=synthetic

# Carpeta local alternativa con parquets exportados desde Redshift/Sperant.
# Si la usas, pásala en scripts con --input-dir o exporta aquí para tus propios scripts.
MLU_SPERANT_LOCAL_DIR=

REDSHIFT_SCHEMA=tu_schema
REDSHIFT_HOST=tu_host_redshift
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=tu_database
REDSHIFT_USER=tu_usuario
REDSHIFT_PASSWORD=tu_password

# Tablas recomendadas para construir la universidad con data real.
REDSHIFT_TABLES=proforma_unidad,procesos,datos_extras,unidades,clientes,proyectos
RAW_OUTPUT_FORMAT=parquet
FORCE_EXTRACT=false
